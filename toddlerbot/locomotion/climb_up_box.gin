PPOConfig.num_timesteps = 800_000_000
SimConfig.playback_speed = 1.0

# Action parameters
ActionConfig.action_parts = ['leg', 'arm', 'waist', 'neck']

# Observation parameters
# Option 1: Phase signal (use_phase_signal=True, default)
#   num_single_obs = 2 (phase) + 3 (cmd) + 30 (motor_pos) + 30 (motor_vel) + 30 (last_act) + 3 (ang_vel) + 4 (quat) = 102
#   num_single_privileged_obs = 102 + 30 (motor_pos_error) + 3 (lin_vel) + 30 (actuator_force) + 2 (stance) + 2 (ref_stance) = 169
ObsConfig.num_single_obs = 102
ObsConfig.num_single_privileged_obs = 169

# Option 2: Motion phase (use_phase_signal=False)
#   num_single_obs = 60 (ref_motor_pos+vel) + 3 (cmd) + 30 (motor_pos) + 30 (motor_vel) + 30 (last_act) + 3 (ang_vel) + 4 (quat) = 160
#   num_single_privileged_obs = 160 + 30 (motor_pos_error) + 3 (lin_vel) + 30 (actuator_force) + 2 (stance) + 2 (ref_stance) = 227
# ObsConfig.use_phase_signal = False
# ObsConfig.num_single_obs = 160
# ObsConfig.num_single_privileged_obs = 227

