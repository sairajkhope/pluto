# Without ZMP reference motion:
RewardScales.lin_vel_xy = 2.0
RewardsConfig.lin_vel_tracking_sigma = 1000.0
RewardScales.ang_vel_z = 1.5
RewardsConfig.ang_vel_tracking_sigma = 4.0
RewardScales.penalty_ang_vel_xy = 1.0
#RewardScales.penalty_orientation = 10.0 # Penalize tilt from upright
RewardScales.torso_quat = 2.5
#RewardScales.torso_pos_xy = 5.0
RewardScales.penalty_action_rate = 2.0 # Sum of squared action changes
RewardScales.penalty_pose = 0.5  # Penalize controlled joints deviating from default
# Pose weights for 12 leg joints (must match action_parts=['leg']):
# Order: left_hip_pitch, left_hip_roll, left_hip_yaw, left_knee, left_ankle_roll, left_ankle_pitch,
#        right_hip_pitch, right_hip_roll, right_hip_yaw, right_knee, right_ankle_roll, right_ankle_pitch
RewardsConfig.pose_weights = [0.01, 1.0, 5.0, 0.01, 5.0, 5.0, 0.01, 1.0, 5.0, 0.01, 5.0, 5.0]
RewardsConfig.close_feet_threshold = 0.06  # 6cm lateral distance between feet
RewardScales.penalty_close_feet_xy = 10.0  # Penalize feet crossing/too close
RewardScales.alive = 1.0  # Constant reward per timestep for staying alive)
RewardScales.feet_phase = 7.5  # Foot height tracking during swing)
RewardScales.penalty_feet_ori = 5.0  # Penalize tippy-toe, keep feet flat
RewardsConfig.swing_height = 0.04  # Meters
RewardsConfig.feet_phase_tracking_sigma = 0.0007  # Scaled for swing_height=0.03 (0.8 * 0.03²)

# Domain randomization
DomainRandConfig.add_head_pose = True
# DomainRandConfig.add_push = True

# Optional: Harsher domain randomization for better sim-to-real robustness
