#     ["slope", "rough", "stairs"],
#     ["rough", "stairs", "rough"]
# ]
# TerrainConfig.random_spawn = True  # Random spawn across tiles

ActionConfig.action_parts = ['leg']
# ActionConfig.action_parts = ['leg', 'waist']
ActionConfig.cycle_time = 0.72

# Observation parameters
# Note: last_act size depends on action_parts. With action_parts=['leg'], last_act=12.
#
# Option 1: Phase signal (use_phase_signal=True, default) with action_parts=['leg'] (12 actions)
#   num_single_obs = 2 (phase) + 3 (cmd) + 30 (motor_pos) + 30 (motor_vel) + 12 (last_act) + 3 (ang_vel) + 4 (quat) = 84
#   num_single_privileged_obs = 84 + 30 (motor_pos_error) + 3 (lin_vel) + 30 (actuator_force) + 2 (stance) + 2 (ref_stance) = 151
ObsConfig.num_single_obs = 84
ObsConfig.num_single_privileged_obs = 151
# with info["push"] included in privileged obs: 
# ObsConfig.num_single_privileged_obs = 153

# Option 2: Motion phase (use_phase_signal=False) with action_parts=['leg'] (12 actions)
#   num_single_obs = 24 (ref_motor_pos+vel for 12 joints) + 3 (cmd) + 30 (motor_pos) + 30 (motor_vel) + 12 (last_act) + 3 (ang_vel) + 4 (quat) = 106
#   num_single_privileged_obs = 106 + 30 (motor_pos_error) + 3 (lin_vel) + 30 (actuator_force) + 2 (stance) + 2 (ref_stance) = 173
# ObsConfig.use_phase_signal = False
# ObsConfig.num_single_obs = 106
# ObsConfig.num_single_privileged_obs = 173

