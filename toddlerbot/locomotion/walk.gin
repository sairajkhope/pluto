PPOConfig.episode_length = 1000
PPOConfig.num_timesteps = 1000_000_000

# Terrain configuration
# Single flat tile (default for walking)
TerrainConfig.manual_map = [["flat"]]
TerrainConfig.random_spawn = False  # Spawn at center (deterministic)

# Example multi-terrain setup (uncomment to use):
# TerrainConfig.manual_map = [
